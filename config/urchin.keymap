#include <behaviors.dtsi>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/outputs.h>
#include <dt-bindings/zmk/pointing.h>

// Layer definitions
#define QWERTY 0
#define LOWER 1
#define RAISE 2
#define MOV 3
#define ADJUST 4
#define NUM 5
#define SETTINGS 6
// -----------------

&sk {
	// don't release mods on other mods presses
	ignore-modifiers;
};


/ {
	behaviors {
		// Enables holding the first mod-tap key
		// by performing a tap-release-hold sequence.
		// To use it: "&qt KEYCODE1 KEYCODE2"
		qt: quick_tap {
			compatible = "zmk,behavior-hold-tap";
			label = "QUICK_TAP";
			#binding-cells = <2>;
			flavor = "tap-preferred";
			tapping-term-ms = <200>;
			bindings = <&kp>, <&kp>;
		};
	};
	macros {
		// sometimes my device thinks a modifier is being held down
		// pressing all modifiers fixes it.
		unstick: unstick {
			label = "ZM_unstick";
			compatible = "zmk,behavior-macro";
			#binding-cells = <0>;
			bindings = <&kp LSHIFT &kp RSHIFT &kp LCTRL &kp RCTRL &kp LALT &kp RALT &kp LGUI &kp RGUI>;
		};

        macro1: macro_string_v1q {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&kp V
                 &kp LS(N5)
                 &kp N1
                 &kp Q
                 &kp LS(N1)
                 &kp LS(T)
                 &kp LS(V)
                 &kp N6
                 &kp W
                 &kp LS(M)>;
        };

        macro2: macro_string_one {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&kp Y &kp N0 &kp N4 &kp N5 &kp N7 &kp N5 &kp N9 &kp N5 &kp R
                    &kp LS(H) &kp N3 &kp C &kp T &kp N0 &kp R
                    &kp LS(R) &kp N3 &kp N4 &kp L &kp P &kp N3
                    &kp LS(C) &kp N4 &kp S &kp T &kp R &kp N1 &kp L &kp L &kp N0>;
        };

        macro3: macro_password_one {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&kp LS(Z) &kp N9
                    &kp LS(T) &kp N4 &kp J &kp H &kp N4
                    &kp LS(Z) &kp Q &kp H &kp DLLR
                    &kp LS(B) &kp F &kp P &kp LS(I)>;
        };

        macro4: macro_number_one {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&kp N2 &kp N4 &kp N1 &kp N7 &kp N9 &kp N0 &kp N6>;
        };

        macro5: macro_string_two {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&kp LS(B) &kp N3 &kp L &kp DLLR &kp N
                    &kp LS(R) &kp V &kp N1 &kp Z
                    &kp LS(F) &kp N3 &kp R &kp N &kp DLLR &kp N &kp D &kp N3 &kp Z>;
        };

        macro6: macro_string_three {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&kp N3 &kp S &kp T &kp R &kp N3 &kp L &kp L &kp N4
                    &kp LS(R) &kp N3 &kp N4 &kp L &kp P &kp N3
                    &kp AMPS
                    &kp LS(R) &kp V &kp N1 &kp Z>;
        };
	};

	combos {
		compatible = "zmk,combos";
		// both left thumb keys
		combo_settings {
			timeout-ms = <200>;
			key-positions = <30 31>;
			bindings = <&mo SETTINGS>;
		};
        combo_num {
            timeout-ms = <200>;
            key-positions = <31 33>;
            bindings = <&mo ADJUST>;
        };
	};

    tap_dances {
        td_q_tab: td_q_tab {
            compatible = "zmk,behavior-tap-dance";
            label = "TD_Q_TAB";
            #binding-cells = <0>;
            tapping-term-ms = <215>;
            bindings = <&kp Q &kp TAB>;
        };
        td_a_esc: td_a_esc {
            compatible = "zmk,behavior-tap-dance";
            label = "TD_A_ESC";
            #binding-cells = <0>;
            tapping-term-ms = <215>;
            bindings = <&kp A &kp ESC>;
        };
        td_onegr: td_onegr {
            compatible = "zmk,behavior-tap-dance";
            label = "TD_ONEGR";
            #binding-cells = <0>;
            tapping-term-ms = <215>;
            bindings = <&kp N1 &kp GRAVE>;
        };
        td_extil: td_extil {
            compatible = "zmk,behavior-tap-dance";
            label = "TD_EXTIL";
            #binding-cells = <0>;
            tapping-term-ms = <215>;
            bindings = <&kp LS(N1) &kp TILDE>;
        };
        td_sclqt: td_sclqt {
            compatible = "zmk,behavior-tap-dance";
            label = "TD_SCLQT";
            #binding-cells = <0>;
            tapping-term-ms = <215>;
            bindings = <&kp SCLN &kp QUOT>;
        };
        td_whome: td_whome {
            compatible = "zmk,behavior-tap-dance";
            label = "TD_WHOME";
            #binding-cells = <0>;
            tapping-term-ms = <215>;
            bindings = <&kp W &kp HOME>;
        };
        td_eend: td_eend {
            compatible = "zmk,behavior-tap-dance";
            label = "TD_EEND";
            #binding-cells = <0>;
            tapping-term-ms = <215>;
            bindings = <&kp E &kp END>;
        };
        td_ene: td_ene {
            compatible = "zmk,behavior-tap-dance";
            label = "TD_ENE";
            #binding-cells = <0>;
            tapping-term-ms = <215>;
            bindings = <&kp N &kp RA(N)>;
        };
    };

	keymap {
		compatible = "zmk,keymap";
		default_layer {
			label = "Qwerty";
			bindings = <
            &td_q_tab &td_whome &td_eend &kp R &kp T &kp Y &kp U &kp I &kp O &kp P
            &td_a_esc &kp S &kp D &kp F &kp G &kp H &kp J &kp K &kp L &td_sclqt
            &qt LSHIFT Z &qt LCTRL X &qt LALT C &qt LGUI V &kp B &td_ene &qt RGUI M &qt RALT COMMA &qt RCTRL DOT &qt RSHIFT SLASH
            &lt LOWER BSPC &lt NUM SPACE &kp SPACE &lt RAISE ENTER
            >;
		};

		lower_layer {
			label = "Lower";
			bindings = <
            &td_onegr &kp N2 &kp N3 &kp N4 &kp N5         &kp N6 &kp N7 &kp N8 &kp N9 &kp N0
            &kp ESC &kp LA(TAB) &kp RC(TAB) &key_repeat  &kp TAB        &kp BSLH &kp MINUS &kp EQUAL &kp LBKT &kp RBKT
            &kp LC(Z) &kp LC(X) &kp LC(C) &kp LC(V) &kp LC(Y) &kp CAPS &caps_word &qt LALT COMMA &kp DOT &kp SLASH
                                         &trans &kp ENTER    &mo ADJUST &tog MOV
			>;
		};

		raise_layer {
			label = "Raise";
			bindings = <
            &td_extil &kp LS(N2) &none &kp LS(N4) &kp LS(N5)    &kp LS(N6) &kp LS(N7) &kp LS(N8) &kp LS(N9) &kp LS(N0)
            &kp PRINTSCREEN &kp LG(S) &kp PG_UP &kp PG_DN &kp LA(LC(DELETE)) &kp PIPE &kp UNDER &kp PLUS &kp LS(LBKT) &kp LS(RBKT)
            &kp LSHIFT &kp LCTRL &kp LALT &kp LGUI &trans &kp LEFT &kp DOWN &kp UP &kp RIGHT &trans
                                    &tog MOV &trans    &trans &trans
			>;
		};

		mov_layer {
			label = "Mov";
			bindings = <
            &to QWERTY &to QWERTY &none &to QWERTY &to QWERTY &kp C_PLAY_PAUSE &kp C_VOL_DN &kp C_VOL_UP &kp C_MUTE &to QWERTY
            &to QWERTY &to QWERTY &mkp LCLK &mkp RCLK &mkp MCLK &mmv MOVE_LEFT &mmv MOVE_DOWN &mmv MOVE_UP &mmv MOVE_RIGHT &to QWERTY
            &kp LSHIFT &kp LCTRL &kp LALT &kp LGUI &to QWERTY &msc SCRL_LEFT &msc SCRL_DOWN &msc SCRL_UP &msc SCRL_RIGHT &to QWERTY
                                    &none &none    &none &none
			>;
		};

		adjust_layer {
			label = "Adjust";
			bindings = <
            &trans &trans &kp END &trans &trans        &macro1 &macro3 &macro4 &macro2 &trans
            &kp HOME &trans &kp C_BRI_UP &kp C_BRI_DN &trans &macro5 &macro6 &trans &trans &trans
            &trans &trans &trans &trans &trans         &trans &trans &trans &trans &trans
                                    &trans &trans    &trans &trans
			>;
		};

		num_layer {
			label = "Num";
			bindings = <
            &kp F1 &kp F2  &kp F3  &kp F4  &trans      &trans &trans &trans &kp DEL &kp BSPC
            &kp F5 &kp F6  &kp F7  &kp F8  &trans      &trans &trans &trans &trans &kp QUOT
            &kp F9 &kp F10 &kp F11 &kp F12 &trans      &trans &trans &trans &trans &trans
                                    &trans &trans    &trans &trans
			>;
		};

		settings_layer {
			label = "Sett";
			bindings = <
			&bootloader &none &none &bt BT_CLR &bt BT_SEL 0     &bt BT_SEL 3 &none &unstick &none &bootloader 
			&none       &none &none &none      &bt BT_SEL 1     &bt BT_SEL 4 &none &none    &none &none
			&studio_unlock &none &none &none   &bt BT_SEL 2     &bt BT_SEL 5 &none &none    &none &studio_unlock
									&none &none     &none &none 

			>;
		};
	};
};
