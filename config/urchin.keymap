#include <behaviors.dtsi>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/outputs.h>

// Layer definitions
#define QWERTY 0
#define LOWER 1
#define RAISE 2
#define MOV 3
#define ADJUST 4
#define NUM 5
#define SETTINGS 6
// -----------------

&sk {
	// don't release mods on other mods presses
	ignore-modifiers;
};


/ {
	behaviors {
		// Enables holding the first mod-tap key
		// by performing a tap-release-hold sequence.
		// To use it: "&qt KEYCODE1 KEYCODE2"
		qt: quick_tap {
			compatible = "zmk,behavior-hold-tap";
			label = "QUICK_TAP";
			#binding-cells = <2>;
			flavor = "hold-preferred";
			tapping-term-ms = <200>;
			quick-tap-ms = <200>;
			bindings = <&kp>, <&kp>;
		};
	};

	macros {
		// sometimes my device thinks a modifier is being held down
		// pressing all modifiers fixes it.
		unstick: unstick {
			label = "ZM_unstick";
			compatible = "zmk,behavior-macro";
			#binding-cells = <0>;
			bindings = <&kp LSHIFT &kp RSHIFT &kp LCTRL &kp RCTRL &kp LALT &kp RALT &kp LGUI &kp RGUI>;
		};
        macro_undo {
            label = "UNDO";
            compatible = "zmk,macro";
            bindings = <&kp LCTRL &kp Z>;
        };
        macro_cut {
            label = "CUT";
            compatible = "zmk,macro";
            bindings = <&kp LCTRL &kp X>;
        };
        macro_copy {
            label = "COPY";
            compatible = "zmk,macro";
            bindings = <&kp LCTRL &kp C>;
        };
        macro_paste {
            label = "PASTE";
            compatible = "zmk,macro";
            bindings = <&kp LCTRL &kp V>;
        };
        macro_redo {
            label = "REDO";
            compatible = "zmk,macro";
            bindings = <&kp LCTRL &kp Y>;
        };
        macro_lalttab {
            label = "LALT_TAB";
            compatible = "zmk,macro";
            bindings = <&kp LALT &kp TAB>;
        };
        macro_rctrltab {
            label = "RCTRL_TAB";
            compatible = "zmk,macro";
            bindings = <&kp RCTRL &kp TAB>;
        };
        macro_winshot {
            label = "WINSHOT";
            compatible = "zmk,macro";
            bindings = <&kp LGUI &kp S>;
        };
        macro_n_tilde {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&kp RALT &kp N>; // Assumes RALT + N sends 'ñ' on your OS
        };
	};

	combos {
		compatible = "zmk,combos";
		// both left thumb keys
		combo_settings {
			timeout-ms = <200>;
			key-positions = <30 31>;
			bindings = <&mo SETTINGS>;
		};
        combo_num {
            timeout-ms = <200>;
            key-positions = <31 33>;
            bindings = <&mo ADJUST>;
        };
	};

    tap_dances {
        compatible = "zmk,tap-dance";
        td_q_tab {
            label = "TD_Q_TAB";
            tapping-term-ms = <215>;
            bindings = <&kp Q &kp TAB>;
        };
        td_a_esc {
            label = "TD_A_ESC";
            tapping-term-ms = <215>;
            bindings = <&kp A &kp ESC>;
        };
        td_onegr {
            label = "TD_ONEGR";
            tapping-term-ms = <215>;
            bindings = <&kp N1 &kp GRAVE>;
        };
        td_extil {
            label = "TD_EXTIL";
            tapping-term-ms = <215>;
            bindings = <&kp N1 &kp GRAVE>;
        };
        td_sclqt {
            label = "TD_SCLQT";
            tapping-term-ms = <215>;
            bindings = <&kp SCLN &kp QUOT>;
        };
        td_whome {
            label = "TD_WHOME";
            tapping-term-ms = <215>;
            bindings = <&kp W &kp HOME>;
        };
        td_eend {
            label = "TD_EEND";
            tapping-term-ms = <215>;
            bindings = <&kp E &kp END>;
        };
        td_ene {
            label = "TD_ENE";
            tapping-term-ms = <215>;
            bindings = <&kp N &macro_n_tilde>;
        };
    };

	keymap {
		compatible = "zmk,keymap";
		default_layer {
			label = "Qwerty";
			bindings = <
            &td_q_tab &td_whome &td_eend &kp R &kp T        &kp Y &kp U &kp I &kp O &kp P
            &td_a_esc &kp S &kp D &kp F &kp G        &kp H &kp J &kp K &kp L &td_sclqt
			&kp Z &kp X &kp C &kp V &kp B           &kp N &kp M &kp COMMA &kp DOT &kp SLASH
                                   &lt LOWER BSPC &lt NUM SPACE       &kp SPACE &lt RAISE ENT
            >;
		};

		lower_layer {
			label = "Lower";
			bindings = <
            &td_onegr   &kp N2         &kp N3          &kp N4       &kp N5         &kp N6   &kp N7 &kp N8 &kp N9 &kp N0
            &kp ESC     &macro_lalttab &macro_rctrltab &key_repeat  &kp TAB        &kp BSLS &kp MINUS &kp EQUAL &kp LBKT &kp RBKT
            &macro_undo &macro_cut     &macro_copy     &macro_paste &macro_redo    &kp CAPS &kp CW_TOGG &mt LALT COMM &kp DOT &kp SLASH
                                         &trans &kp ENT    &mo ADJUST &tog MOV
			>;
		};

		raise_layer {
			label = "Raise";
			bindings = <
            &td_extil &kp AT &kp HASH &kp DLR &kp PERC    &kp CIRC &kp AMPS &kp ASTR &kp LPAR &kp RPAR
            &kp PSCR &macro_winshot &kp PGUP &kp PGDN &kp LA(LC(DELETE)) &kp PIPE &kp UNDER &kp PLUS &kp LCBR &kp RCBR
            &kp PLAY &kp REC &kp PLAY &kp REC &kp STOP &kp LEFT &kp DOWN &kp UP &kp RIGHT &trans
                                    &tog MOV &trans    &trans &trans
			>;
		};

		mov_layer {
			label = "Mov";
			bindings = <
            &none &none &none &none &none &kp C_PLAY_PAUSE &kp VOL_DOWN &kp VOL_UP &kp MUTE &none
            &none &none &none &none &none &none &none &none &none &none
            &kp LSHIFT &kp LCTRL &kp LALT &kp LGUI &none &none &none &none &none &none
                                    &none &none    &none &none
			>;
		};

		adjust_layer {
			label = "Adjust";
			bindings = <
            &trans &trans &kp END &trans &trans        &trans &trans &trans &trans &trans
            &kp HOME &trans &kp BRIU &kp BRID &trans    &trans &trans &trans &trans &trans
            &trans &trans &trans &trans &trans         &trans &trans &trans &trans &trans
                                    &trans &trans    &trans &trans
			>;
		};

		num_layer {
			label = "Num";
			bindings = <
            &kp F1 &kp F2 &kp F3 &kp F4 &kp F5         &kp MS_BTN2 &kp MS_BTN1 &kp MS_U &kp DEL &kp BSPC
            &kp F6 &kp F7 &kp F8 &kp F9 &kp F10        &kp MS_BTN3 &kp MS_L &kp MS_D &kp MS_R &kp QUOT
            &kp F11 &kp F12 &trans &trans &trans       &trans &kp LEFT &trans &trans &trans
                                    &trans &trans    &trans &trans
			>;
		};

		settings_layer {
				label = "Sett";
				bindings = <
				&bootloader &none &none &bt BT_CLR &bt BT_SEL 0               &bt BT_SEL 3 &none &unstick &none &bootloader
				&none &none &none &none &bt BT_SEL 1 						  &bt BT_SEL 4 &none &none &none &none
				&none &none &none &none &bt BT_SEL 2               &bt BT_SEL 5 &none &none &none &none
										&none &none                         &none &none
				>;
		};
	};
};
